{
  "zen-verification-boundary": {
    "PreToolUse": [
      {
        "matcher": "^run_command$",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/zen-shell-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "excavator-migration-boundary": {
    "PreToolUse": [
      {
        "matcher": "^run_command$",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/excavator-shell-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "mcp-role-boundary": {
    "PreToolUse": [
      {
        "matcher": "^(call_mcp_tool|mcp_tool|mcp_.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/mcp-role-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "native-gravity-excavator-review-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/excavator-review-gate.mjs",
        "timeout": 10
      }
    ]
  },
  "native-gravity-primary-review-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/primary-review-gate.mjs",
        "timeout": 10
      }
    ]
  }
}
